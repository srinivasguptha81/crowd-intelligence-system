APP_NAME=CrowdGuard AI
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGIN_REGEX=https://.*\.vercel\.app
MAX_UPLOAD_MB=150
ANALYSIS_MAX_FRAMES=120
YOLO_MODEL=yolov8n.pt
YOLO_CONF=0.30
ENABLE_YOLO=true
RTSP_ENABLED=true
ALLOW_PRIVATE_RTSP=true
RTSP_ALLOWED_HOSTS=
AUTH_ENABLED=false
API_AUTH_TOKEN=
MODEL_PATH=models/crowd_risk_model.joblib
DATABASE_PATH=data/crowdguard.db
DEFAULT_MONITORED_AREA_M2=36.0
DEFAULT_PERSPECTIVE_WEIGHTS=1.35,1.0,0.85
LIVE_TARGET_FPS=6.0
INCIDENT_COOLDOWN_SECONDS=15.0
